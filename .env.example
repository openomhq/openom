# `task setup` copies this file to .env (gitignored) when needed. Task, the local runner
# scripts, and Docker Compose read the same machine-specific configuration from it.

# JDK for the Tauri Android build ONLY (apps/scripts/tauri.mjs sets JAVA_HOME to this for the
# run, leaving your machine-wide JAVA_HOME alone). The generated project uses Gradle 8.14, which
# won't run on a JDK newer than 24 — point this at a compatible one, e.g. Android Studio's
# bundled JBR (a JDK 21). Leave unset to use your existing JAVA_HOME.
#   JAVA_HOME_JBR=C:\Program Files\Android\Android Studio\jbr

# Where Rust commands run — auto | local | docker. On first setup, auto compiles and executes a
# tiny probe, checks Watchexec, and persists local or docker in .env. Later commands are deterministic.
#   local  — cargo on the host (the normal choice for unrestricted development machines)
#   docker — cargo inside a Linux container (a host whose policy blocks executing
#            freshly built binaries: "Access is denied (os error 5)")
#   auto   — select once during setup; use an explicit value to skip the probe.
OPENOM_RUNNER=auto

# Image used for docker/auto. The FULL image ships gcc, which rusqlite's `bundled`
# feature needs to compile SQLite; the -slim tag would fail at that step.
OPENOM_CARGO_IMAGE=rust:1.97.1-bookworm

# Host port the local server binds (docker-compose.yml). 8080 often clashes; 6060
# is a safe default (6000 is on browsers' blocked-ports list).
OPENOM_HTTP_PORT=6060

# Browser port for the containerized desktop fallback. It binds to localhost only.
OPENOM_DESKTOP_PORT=6080

# Harmless local-only credentials shared by Task and Docker Compose. These never configure a
# hosted environment. Change them here only when local port-sharing or policy requires it.
OPENOM_DEV_DATABASE_USER=openom
OPENOM_DEV_DATABASE_PASSWORD=openom
OPENOM_DEV_DATABASE_NAME=openom
OPENOM_DEV_OBJECT_STORE_ACCESS_KEY=openom
OPENOM_DEV_OBJECT_STORE_SECRET_KEY=openompw123
OPENOM_DEV_OBJECT_STORE_BUCKET=openom-trees

# Local observability (grafana/otel-lgtm), OFF by default to spare the machine.
# Set BOTH to turn it on: the profile starts the LGTM container, the flag makes the
# server export to it. Then open Grafana at http://localhost:${OPENOM_GRAFANA_PORT}.
#   COMPOSE_PROFILES=observability
#   OPENOM_OTEL=1
COMPOSE_PROFILES=
OPENOM_OTEL=0
OPENOM_GRAFANA_PORT=3000

# Local Supabase Auth profile only. `true` auto-confirms sign-up so complete local account flows can run;
# `false` exercises the confirmation-required client state (the local stack does not deliver email).
# Hosted Supabase confirmation is configured in the Supabase project, not through this variable.
OPENOM_SUPABASE_MAILER_AUTOCONFIRM=true
