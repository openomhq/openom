# Generated protobuf Rust — checked in on purpose (no build script, so `cargo build`
# needs neither protoc nor buf; regenerate with `cd packages/openom-protocol/proto
# && buf generate`). Mark it generated so review tools collapse it and language
# stats ignore it.
packages/openom-protocol/src/generated/** linguist-generated=true

# Node executes these files directly; keep shebangs portable and Vitest-importable on Windows.
*.mjs text eol=lf

# Containers and Unix hosts execute these files directly; CRLF breaks their shebangs.
*.sh text eol=lf

# SQLx checks migration checksums byte-for-byte. Keep them identical on every platform.
openom/migrations/*.sql text eol=lf
